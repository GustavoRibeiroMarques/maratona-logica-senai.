programa {
  funcao inicio() {
    inteiro primeira, segunda, total

    escreva("Por favor, informe a quantidade da primeira remessa de parafusos: ")
    leia(primeira)
    escreva("Agora, por favor informe a quantidade da segunda remessa de parafusos: ")
    leia(segunda)

    total = primeira + segunda

    escreva("A quantidade total de parafusos disponiveis no estoque é de ",total)


  }
}
